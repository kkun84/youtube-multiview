{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/styles.css",
    "scripts/*.ts",
    "src/**/*.test.ts",
    "test/**/*.spec.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "vite.config.ts"
  ],
  "ignorePatterns": [".mutator/**", "test/support/fake-youtube.js"],
  "ignoreDependencies": ["@effect/tsgo", "@effect/language-service"],
  "duplicates": {
    "mode": "mild",
    "minTokens": 40,
    "minLines": 4,
    "ignoreDefaults": false,
    "threshold": 0.001
  },
  "rules": {
    "unused-dev-dependencies": "error",
    "dev-dependencies-in-production": "off"
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 0
  },
  "boundaries": {
    "zones": [
      {
        "name": "core",
        "patterns": ["src/core/**"]
      },
      {
        "name": "shell",
        "patterns": ["src/shell/**", "src/main.ts", "src/env.d.ts", "src/styles.css", "index.html"]
      },
      {
        "name": "tests",
        "patterns": ["test/**"]
      },
      {
        "name": "tooling",
        "patterns": ["scripts/**", "playwright.config.ts", "vitest.config.ts", "vite.config.ts"]
      }
    ],
    "rules": [
      {
        "from": "core",
        "allow": []
      },
      {
        "from": "shell",
        "allow": ["core"]
      }
    ],
    "coverage": {
      "requireAllFiles": true
    }
  }
}
